# 複製為 .env 後填入實際值；.env 不可提交至版本控制。

# Docker Compose 建立 PostgreSQL 時使用（請改成自己的強密碼）
POSTGRES_USER=farmgm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=farmgm
POSTGRES_PORT=5434

# 遊戲與監控使用的資料庫（SQLAlchemy URL，驅動為 psycopg 3）
DATABASE_URL=postgresql+psycopg://farmgm:change-me@127.0.0.1:5434/farmgm

# pytest 專用資料庫；資料庫名稱必須以 _test 結尾，測試會清空其中的資料
TEST_DATABASE_URL=postgresql+psycopg://farmgm:change-me@127.0.0.1:5434/farmgm_test

# 監控網頁（第一版僅限本機）
APP_HOST=127.0.0.1
APP_PORT=8000
MONITOR_REFRESH_SECONDS=3

# 允許的 Host 標頭（逗號分隔），防止 DNS rebinding
ALLOWED_HOSTS=127.0.0.1,localhost

# 網站管理員；密碼只填雜湊，用 python -m app.hash_password 產生。未設定時管理功能停用
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_HOURS=8
# 背景自動結算排名獎勵的間隔（秒，10–3600）
RANKING_SETTLE_INTERVAL_SECONDS=60
# 由哪個程序執行背景結算（排名獎勵與競賽）：web、bot 或 none；多個程序同時執行也不會重複發獎
BACKGROUND_TASKS_RUNNER=web

# development／production。production 且未設定 DISCORD_DEV_GUILD_ID 時，Bot 啟動時全域同步指令
APP_ENV=development

# 資料庫連線池（每個程序各自一組）；Bot 實際大小至少為 BOT_WORKER_THREADS + 2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10

# Discord Bot（python -m app.discord_bot）。Token 只放在這裡或系統環境變數，不可提交、不可貼到對話或日誌
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# 開發伺服器 ID：設定時指令只同步到這個伺服器（立即生效）
DISCORD_DEV_GUILD_ID=
DISCORD_SYNC_COMMANDS=true
# 預設只有 /farm 面板與 /help；true 時另外註冊完整文字指令
DISCORD_ADVANCED_COMMANDS=false
# 執行遊戲服務的執行緒數（= 同時處理中的指令上限）
BOT_WORKER_THREADS=16

# 音樂播放（原 YTDiscordBot，與農場共用同一個 Bot 與 Token）
MUSIC_ENABLED=true
# true 時可用 !play 等前綴指令（需在 Developer Portal 開啟 Message Content Intent）；預設只用斜線指令
MUSIC_PREFIX_COMMANDS=false
MUSIC_PREFIX=!
MUSIC_VOLUME=0.1
MUSIC_PLAYLIST_LIMIT=20
MUSIC_IDLE_TIMEOUT=300

# Lavalink 音樂伺服器（docker compose 的 lavalink 服務；Bot 不需要 ffmpeg）
# 密碼請自行設定一組隨機字串；Bot 與 Lavalink 共用
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=change-me
# Lavalink 的 Java 記憶體上限
LAVALINK_MAX_HEAP=512M
# YouTube 簽章解析服務 yt-cipher（docker compose 的 yt-cipher 服務）的密碼；請自行設定一組隨機字串，Lavalink 與 yt-cipher 共用
YT_CIPHER_TOKEN=change-me
# 選用：YouTube OAuth refresh token（請用 Google 分身帳號）。留空時 Lavalink 啟動後在 docker compose logs lavalink 顯示授權網址與代碼，
# 授權完成後日誌會印出 refresh token，填到這裡再 docker compose up -d --force-recreate lavalink。屬於帳號憑證，不可提交或外流
YOUTUBE_OAUTH_REFRESH_TOKEN=

# 介紹網站（python -m app.site）；對外公開請改 SITE_HOST=0.0.0.0
SITE_HOST=127.0.0.1
SITE_PORT=24444
SITE_SUPPORT_URL=
